# Agent governance: live writer locks are runtime/ephemeral (pid, lease, expiry).
# The canonical lock SYSTEM is code (ultimate_pipeline/contracts/writer_lock.py) and
# the policy is tracked (.agent_locks/README.md); the live lock instance is NOT tracked.
.agent_locks/*.lock

# Phase G evidence: full preflight dumps are deterministically regenerable by
# phase_g8_acceptance.py (run_preflight); only the summarized loadability
# section of PHASE_G_ACCEPTANCE.json is tracked.
reports/post_audit_hardening/*/preflight_report.json
reports/post_audit_hardening/*/*/preflight_report.json
reports/post_audit_hardening/*/baseline_g0_preflight/

# ---------------------------------------------------------------------------
# C2 3D-package: raw interchangeable 3D artifacts (never committed; their
# hashes are captured in artifacts_fullmap/osm2world_status.json which IS
# tracked). Small stats JSONs remain tracked.
# ---------------------------------------------------------------------------
reports/post_audit_hardening/*/artifacts_fullmap/*.obj
reports/post_audit_hardening/*/artifacts_fullmap/*.mtl
reports/post_audit_hardening/*/artifacts_fullmap/*.log


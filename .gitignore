reports/post_audit_hardening/20260810T000000Z_C2_REMEDIATION/fullmap_mesh/*.obj
reports/post_audit_hardening/20260810T000000Z_C2_REMEDIATION/fullmap_mesh/*.mtl
reports/post_audit_hardening/20260810T000000Z_C2_REMEDIATION/visual_layer/artifacts_visual/*.obj

# confirmed via a repo-wide search before excluding. Happens to share a path
# with an argparse default in run_full_domain_gap.py/run_gnn_pipeline.py,
# but that default is unused by this branch's current pipeline flow.
cities/ingolstadt/manual_grid0821.xodr
reports/post_audit_hardening/20260813T000000Z_C3_REGOVERN/candidate_g_semantic_enriched_corrected_parent.xodr
reports/post_audit_hardening/20260814T000000Z_E1_CRASH_SAFE_ELEVATION/candidate_h_elevated_enriched_crash_safe.xodr

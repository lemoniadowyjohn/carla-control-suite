    },
    {
      "path": "road/Lane, geometry, topology, waypoints, traffic manager",
      "requirement": "LOCAL_MAP_ONLY",
      "gate": "unaffected; no geoReference dependency"
    },
    {
      "path": "LargeMapManager local<->global streaming",

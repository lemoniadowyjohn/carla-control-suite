#!/bin/bash
#SBATCH --job-name=seg_baseline
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=8
#SBATCH --mem=32G
#SBATCH --time=06:00:00
#SBATCH --output=logs/%x_%j.out
#SBATCH --error=logs/%x_%j.err

set -euo pipefail

DATASET_PATH="${DATASET_PATH:-datasets/seg_dataset}"
CAMERA="${CAMERA:-front}"
OUT_DIR="${OUT_DIR:-runs/seg_baseline}"
EPOCHS="${EPOCHS:-10}"
BATCH="${BATCH:-8}"
LR="${LR:-1e-4}"
NUM_CLASSES="${NUM_CLASSES:-256}"

# module load cuda/...
# source venv/bin/activate

python -m ultimate_pipeline.perception.min_train_segmentation \
  --dataset "$DATASET_PATH" \
  --camera "$CAMERA" \
  --out-dir "$OUT_DIR" \
  --epochs "$EPOCHS" \
  --batch "$BATCH" \
  --lr "$LR" \
  --num-classes "$NUM_CLASSES"
